{
  "name": "accuscan-web",
  "private": true,
  "version": "2.0.0",
  "description": "In-browser handwriting recognition demo: draw or upload a line, a CRNN reads it on your device.",
  "license": "MIT",
  "author": "Shashank Yadav",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port 5470 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5471 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshot": "node scripts/screenshot.mjs",
    "demo-gif": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
